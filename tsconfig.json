{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mawl/agents": ["packages/agents/src/index.ts"],
      "@mawl/auth": ["packages/auth/src/index.ts"],
      "@mawl/core": ["packages/core/src/index.ts"],
      "@mawl/evaluation": ["packages/evaluation/src/index.ts"],
      "@mawl/mcp": ["packages/mcp/src/index.ts"],
      "@mawl/observability": ["packages/observability/src/index.ts"],
      "@mawl/parsers": ["packages/parsers/src/index.ts"],
      "@mawl/permissions": ["packages/permissions/src/index.ts"],
      "@mawl/policy": ["packages/policy/src/index.ts"],
      "@mawl/prompts": ["packages/prompts/src/index.ts"],
      "@mawl/providers": ["packages/providers/src/index.ts"],
      "@mawl/runtime": ["packages/runtime/src/index.ts"],
      "@mawl/sandbox": ["packages/sandbox/src/index.ts"],
      "@mawl/secrets": ["packages/secrets/src/index.ts"],
      "@mawl/security": ["packages/security/src/index.ts"],
      "@mawl/storage": ["packages/storage/src/index.ts"],
      "@mawl/testing": ["packages/testing/src/index.ts"],
      "@mawl/tools": ["packages/tools/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/dist/**", "node_modules"]
}
